"use client";

import Link from "next/link";
import ProductCard from "@/components/ProductCard";
import { useEffect, useState } from "react";
import { getProducts } from "@/lib/products";

export default function TrendingSection() {
  const [featured, setFeatured] = useState<any[]>([]);
  const [trending, setTrending] = useState<any[]>([]);
  const [newArrivals, setNewArrivals] = useState<any[]>([]);

  useEffect(() => {
    async function load() {
      const products = await getProducts();

      const featuredProducts = products.filter((p: any) => p.featured);
      const trendingProducts = products.filter((p: any) => p.trending);
      const newArrivalProducts = products.filter((p: any) => p.newArrival);

      setFeatured(
        featuredProducts.length
          ? featuredProducts.slice(0, 12)
          : products.slice(0, 12)
      );

      setTrending(
        trendingProducts.length
          ? trendingProducts.slice(0, 12)
          : products.slice(12, 24)
      );

      setNewArrivals(
        newArrivalProducts.length
          ? newArrivalProducts.slice(0, 12)
          : products.slice(24, 36)
      );
    }

    load();
  }, []);

  const sections = [
    {
      title: "FEATURED",
      href: "/collections/featured",
      products: featured,
    },
    {
      title: "TRENDING",
      href: "/collections/trending",
      products: trending,
    },
    {
      title: "NEW ARRIVALS",
      href: "/collections/new-arrivals",
      products: newArrivals,
    },
  ];

  return (
    <>
      {sections.map((section) => (
        <section
          key={section.title}
          className="max-w-7xl mx-auto px-6 py-16"
        >
          <div className="flex items-center justify-between mb-8">
            <h2 className="text-4xl font-black">
              {section.title}
            </h2>

            <Link
              href={section.href}
              className="text-sm font-semibold hover:underline"
            >
              SEE ALL →
            </Link>
          </div>

          <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            {section.products.map((product: any) => (
              <ProductCard
                key={product.id}
                product={product}
              />
            ))}
          </div>
        </section>
      ))}
    </>
  );
}
